# The Vercel CLI does not read .gitignore, so a local `vercel` deploy would
# happily upload the real .env. List the secrets here first.
.env
.env.*
!.env.example

# Vercel installs and builds from source; these are local artifacts and only
# slow the upload down.
node_modules
.next
tsconfig.tsbuildinfo
*.log

# Notes for humans and agents, read by nothing in the build.
.claude
.agents
AGENTS.md
CLAUDE.md


# Deliberately NOT ignored:
#   api-client/ - the API client modules the app imports (`@/api-client`).
#                 It used to be `api/`, and Vercel turns a root `api/` into
#                 one serverless function per file - 12 of them, which on its
#                 own hits the Hobby plan's 12-function ceiling and fails the
#                 deploy. Never name a root folder `api` unless its files
#                 really are request handlers.
